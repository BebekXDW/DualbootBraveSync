{
  "manifest_version": 3,
  "name": "Brave Dual-Boot Sync",
  "version": "2.0.0",
  "description": "Keeps logins live-synced between Arch and Windows, and shows profile sync status and missing extensions.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "storage", "alarms", "tabs", "management"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Dual-Boot Sync", "default_popup": "popup.html" }
}
