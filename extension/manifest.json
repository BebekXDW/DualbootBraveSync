{
  "manifest_version": 3,
  "name": "Cookie Sync (dual boot)",
  "version": "1.0.0",
  "description": "Saves cookies to a shared file while you browse and loads them when Brave starts, so Arch and Windows share logins.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Cookie Sync", "default_popup": "popup.html" }
}
